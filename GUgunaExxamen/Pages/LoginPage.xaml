<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUgunaExxamen.Pages.LoginPage"
             BackgroundColor="#FFFFFF"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="28,40" Spacing="22">
            <Border Stroke="#B91C1C" StrokeThickness="2" StrokeShape="RoundRectangle 24"
                    BackgroundColor="#FEF2F2" WidthRequest="92" HeightRequest="92"
                    HorizontalOptions="Center">
                <Grid>
                    <Ellipse Fill="#B91C1C" WidthRequest="58" HeightRequest="58" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Text="G" TextColor="White" FontSize="34" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="LOGIN" Style="{StaticResource PageTitle}" FontSize="20" />
            <Label Text="Accede para registrar los datos del estudiante"
                   HorizontalTextAlignment="Center" TextColor="#6B7280" />

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="14" ColumnSpacing="12">
                <Label Grid.Row="0" Grid.Column="0" Text="Usuario" Style="{StaticResource SectionLabel}" />
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FormBorder}">
                    <Entry x:Name="UsuarioEntry" Placeholder="Escribe tu usuario" ClearButtonVisibility="WhileEditing" />
                </Border>
                <Label Grid.Row="1" Grid.Column="0" Text="Contraseña" Style="{StaticResource SectionLabel}" />
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBorder}">
                    <Entry x:Name="ContrasenaEntry" Placeholder="Escribe tu contraseña" IsPassword="True" />
                </Border>
            </Grid>

            <Button Text="INICIAR SESIÓN" Clicked="OnIniciarSesionClicked"
                    BackgroundColor="#B91C1C" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
